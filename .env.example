# Real values belong only in .env, never appsettings or ChatId.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS_0=
TELEGRAM_CHAT_IDS_1=
# Production: strong 12+ character password and random 32+ character bridge token.
DASHBOARD_PASSWORD=
BRIDGE_TOKEN=
# Laptop creates data/bridge.key if BRIDGE_TOKEN is empty.
Bridge__BackendUrl=ws://127.0.0.1:5080/bridge/ws
Bridge__LocalPort=8766
# On the Windows agent, use wss://your-domain/bridge/ws for a remote server.
TRUSTED_PROXY=
